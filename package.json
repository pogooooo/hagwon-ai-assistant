{
  "name": "axr-prototype",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "npm run academy:dev",
    "build": "next build",
    "start": "sirv out --host 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "rag:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/features/rag-consultation/server/dev/dev-server.ts",
    "academy:dev": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/features/academy-operations/server.ts",
    "prepare": "husky",
    "cap:add:android": "npm run build && cap add android",
    "cap:add:ios": "npm run build && cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "dev:prototype": "next dev",
    "ai:check": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/features/rag-consultation/server/generation/smoke-provider.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@napi-rs/canvas": "1.1.0",
    "@tanstack/react-query": "5.104.5",
    "axios": "1.20.0",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@huggingface/transformers": "4.3.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "kiwi-nlp": "0.24.1",
    "lint-staged": "17.6.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "sirv-cli": "3.0.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
