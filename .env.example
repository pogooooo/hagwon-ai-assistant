# No environment variables are required for the blank starter.
# Add shared variable names here when a feature needs them.

# 4. RAG 상담(서버 전용, NEXT_PUBLIC_ 금지). 미설정 시 생성 기능은 disabled 로 동작한다.
# disabled | mock | openai-compatible
RAG_GENERATION_PROVIDER=disabled
RAG_GENERATION_BASE_URL=
RAG_GENERATION_MODEL=
RAG_GENERATION_API_KEY=
# 약관·미성년 이용·국외 처리 검토 완료 전에는 false 유지
RAG_GENERATION_ALLOW_PERSONAL_DATA=false
RAG_GENERATION_DAILY_CALL_LIMIT=

# 클라이언트가 호출할 상담 API 주소(비밀값 아님)
NEXT_PUBLIC_RAG_API_BASE_URL=
