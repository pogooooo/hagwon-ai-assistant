# Server-only settings. Never use NEXT_PUBLIC_ for a secret.
# Copy to .env.local; npm run dev / academy:dev loads it.
AXR_OPERATIONS_DB=.local/academy-operations.sqlite
AXR_OPERATIONS_PORT=8791
AXR_OPERATIONS_DEMO_PASSWORD=axr-demo

# gemini | clova | disabled | mock | openai-compatible
RAG_GENERATION_PROVIDER=gemini
RAG_GEMINI_MODEL=gemini-3.5-flash-lite
RAG_GEMINI_API_KEY=
# Explicit per-provider permission; leave false for unapproved real student data.
RAG_GEMINI_ALLOW_PERSONAL_DATA=false
RAG_GENERATION_DAILY_CALL_LIMIT=100

# Later switch RAG_GENERATION_PROVIDER=clova and set a model available to your account.
RAG_CLOVA_MODEL=HCX-DASH-002
RAG_CLOVA_API_KEY=
RAG_CLOVA_ALLOW_PERSONAL_DATA=false

# Optional generic provider
RAG_GENERATION_BASE_URL=
RAG_GENERATION_MODEL=
RAG_GENERATION_API_KEY=
RAG_GENERATION_ALLOW_PERSONAL_DATA=false
NEXT_PUBLIC_RAG_API_BASE_URL=
