
[Unit]
Description=AXR academy operations
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=axr
Group=axr
WorkingDirectory=/opt/axr
EnvironmentFile=/etc/axr/operations.env
StateDirectory=axr
UMask=0077
ExecStart=/usr/local/bin/node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/features/academy-operations/server.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
